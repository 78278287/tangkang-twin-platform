# ============================================
# 糖康孪生平台 环境变量配置模板
# 使用方法：复制本文件并重命名为 .env，填入你的真实配置
# ============================================

# 数据库配置（MySQL）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=tangkang_db

# 服务端口
PORT=3001

# JWT密钥（用于用户鉴权，生产环境请替换为随机强密钥）
JWT_SECRET=请替换为随机的强密钥

# OpenAI / DeepSeek API（AI助手功能，可选）
OPENAI_API_KEY=sk-你的API密钥
